# P2P Share - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=10000
NODE_ENV=development

# Security
CORS_ORIGIN=*
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100           # max requests per windowMs

# WebRTC TURN Servers (Optional - use public servers if not set)
# TURN_SERVER_1_URLS=turn:your-turn-server.com:3478
# TURN_SERVER_1_USERNAME=your-username
# TURN_SERVER_1_CREDENTIAL=your-password
# TURN_SERVER_2_URLS=turn:another-turn-server.com:3478
# TURN_SERVER_2_USERNAME=another-username
# TURN_SERVER_2_CREDENTIAL=another-password

# File Transfer Limits (in bytes)
MAX_FILE_SIZE=1073741824      # 1GB
MAX_CHUNK_SIZE=16384          # 16KB
MAX_PENDING_FILES_PER_ROOM=10

# Logging
LOG_LEVEL=info
LOG_FORMAT=json